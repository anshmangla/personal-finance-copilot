# Groq Cloud API Key (Get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Neon PostgreSQL Connection String (Get pooled connection string from https://neon.tech)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require

# JWT Secret for Signing App Tokens (Generate any secure random string)
JWT_SECRET=supersecretjwtsecretkey_change_me_in_production

# Google OAuth Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
